{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/rs-data/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/universe-data/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/market-data/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/gmail/import/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/extract-breadth/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/daily-scan/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/nightly-scan/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/gmail-import/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/nightly-scan",
      "schedule": "0 2 * * 1-5"
    },
    {
      "path": "/api/cron/gmail-import",
      "schedule": "0 4 * * 2-6"
    }
  ]
}
